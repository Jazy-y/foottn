# ─────────────────────────────────────────────────────────────────────────────
# FootTN — Environment Variables Template
# Copy this file to .env.local for local dev, or paste values into Vercel.
# NEVER commit .env.local — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (public — safe to expose in browser) ─────────────────────────────
# Found in Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_* / pk_test_* for demo/staging. Never use live keys on demo URLs.
# Found in Stripe Dashboard → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Signing secret of the webhook endpoint (/api/stripe/webhook), optional
STRIPE_WEBHOOK_SECRET=

# ── Cloudinary (unsigned uploads for avatars, stadium and post images) ───────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Email (optional) ──────────────────────────────────────────────────────────
# Booking confirmations are sent through Resend when a key is present.
RESEND_API_KEY=
EMAIL_FROM="FootTN <noreply@your-domain.com>"

# ── App ───────────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL for demo (e.g. https://foottn-demo.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" in a demo deployment to disable production browser source maps.
NEXT_PUBLIC_DEMO_MODE=false
